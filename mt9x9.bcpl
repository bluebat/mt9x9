// 9x9 multiplication table in BCPL
// CC0, Wei-Lun Chao <bluebat@member.fsf.org>, 2026.
// bcplc mt9x9.bcpl -o mt9x9 && ./mt9x9

GET "LIBHDR"
LET start() BE $(
    LET i = 1
    WHILE i < 10 DO $(
        FOR j = 1 TO 9 DO $(
            FOR k = i TO i+2 DO $(
                writen(k)
                wrch('x')
                writen(j)
                wrch('=')
                writed(k*j, 2)
                wrch('*T')
            $)
            wrch('*N')
        $)
        newline()
        i := i + 3
    $)
$)
