/*
9x9 multiplication table in Kitten
CC0, Wei-Lun Chao <bluebat@member.fsf.org>, 2026.
*/
// kitten mt9x9.ktn

[1,4,7] {
    [1,2,3,4,5,6,7,8,9] {
        [0,1,2] {
            ->K; dup2 swap K
            (+) dup print
            'x' print
            swap dup print
            '=' print
            (*) dup
            10 (<) if { ' ' print }
            print
            '\t' print
        } each '\n' print drop
    } each '\n' print drop
} each
