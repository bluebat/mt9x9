! 9x9 multiplication table in Hope
! CC0, Wei-Lun Chao <bluebat@member.fsf.org>, 2026.
! hope -f mt9x9.hop

dec item : num # num -> list char;
--- item(j, k) <=
        let left == num2str(k) <> "x" <> num2str(j) <> "=" in
        let right == (if k*j<10 then " " else "") <> num2str(k*j) <> "\t" in
        left <> right;
dec line : num # num # num -> list char;
--- line(i, j, k) <= if k<i+3 then item(j, k) <> line(i, j, k+1) else "\n";
dec block : num # num -> list char;
--- block(i, 10) <= [chr(10)];
--- block(i, j) <= line(i, j, i) <> block(i, j+1);
dec main : num -> list char;
--- main(10) <= "";
--- main(i) <= block(i, 1) <> main(i+3);
write main(1);
