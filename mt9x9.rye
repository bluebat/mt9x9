; 9x9 multiplication table in Rye
; CC0, Wei-Lun Chao <bluebat@member.fsf.org>, 2026.
; rye mt9x9.rye

var 'i 1
while { i <= 9 } { ::i
    for range 1 9 { ::j
        for evals { i i + 1 i + 2 } { ::k
            prn k ++ "x" ++ j ++ "="
            if k * j < 10 { prn " " }
            prn k * j ++ "\t"
        }
        newline |prn
    }
    print ""
    i:: i + 3
}
