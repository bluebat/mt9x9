#!/usr/bin/poke -L
!#
/*
9x9 multiplication table in Poke
CC0, Wei-Lun Chao <bluebat@member.fsf.org>, 2026.
*/
// ./mt9x9.pk || poke -L mt9x9.pk

for (var i = 1; i <= 9; i += 3) {
    for (var j = 1; j <= 9; j++) {
        for (k in [i, i+1, i+2]) {
            printf "%u8dx%u8d=", k, j;
            if (k*j < 10) print " ";
            printf "%u8d\t", k*j;
        }
        print "\n";
    }
    print "\n";
}
